+    /**
+     * List-free burst signal: a cloud link scanner fetches one message from several
+     * distinct IP addresses within seconds. Disabled unless burstMaxDistinctIps >= 2.
+     */
+    private function isBurstHit(Stat $emailStat, \DateTimeInterface $emailHitDateTime): bool
+    {
+        if (null === $this->connection || $this->burstMaxDistinctIps < 2 || $this->burstWindowSeconds < 1) {
+            return false;
+        }
+
+        // page_hits.date_hit and email_stats_devices.date_opened are stored in UTC.
+        $since = (new \DateTimeImmutable('@'.($emailHitDateTime->getTimestamp() - $this->burstWindowSeconds)))
+            ->format('Y-m-d H:i:s');
+
+        return $this->countClickIps($emailStat, $since) >= $this->burstMaxDistinctIps
+            || $this->countOpenIps($emailStat, $since) >= $this->burstMaxDistinctIps;
+    }
+
+    private function countClickIps(Stat $emailStat, string $since): int
+    {
+        $emailId = $emailStat->getEmail()?->getId();
+        $leadId  = $emailStat->getLead()?->getId();
+
+        if (null === $emailId || null === $leadId) {
+            return 0;
+        }
+
+        try {
+            return (int) $this->connection->fetchOne(
+                'SELECT COUNT(DISTINCT ph.ip_id) FROM '.MAUTIC_TABLE_PREFIX.'page_hits ph
+                 WHERE ph.email_id = :emailId AND ph.lead_id = :leadId AND ph.date_hit >= :since',
+                ['emailId' => $emailId, 'leadId' => $leadId, 'since' => $since]
+            );
+        } catch (\Throwable) {
+            return 0;
+        }
+    }
+
+    private function countOpenIps(Stat $emailStat, string $since): int
+    {
+        $statId = $emailStat->getId();
+
+        if (null === $statId) {
+            return 0;
+        }
+
+        try {
+            return (int) $this->connection->fetchOne(
+                'SELECT COUNT(DISTINCT d.ip_id) FROM '.MAUTIC_TABLE_PREFIX.'email_stats_devices d
+                 WHERE d.stat_id = :statId AND d.date_opened >= :since',
+                ['statId' => $statId, 'since' => $since]
+            );
+        } catch (\Throwable) {
+            return 0;
+        }
+    }
